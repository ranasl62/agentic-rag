# Next.js frontend: build and run inside Docker
FROM node:20-alpine AS builder

WORKDIR /app

# Build args passed from docker-compose.yml
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_AGENT_API_KEY=

COPY web/package.json web/package-lock.json* ./
RUN npm ci

COPY web/ .

# Write .env.production so Next.js reliably inlines NEXT_PUBLIC_* at build time
RUN printf "NEXT_PUBLIC_API_URL=%s\nNEXT_PUBLIC_AGENT_API_KEY=%s\n" \
    "$NEXT_PUBLIC_API_URL" "$NEXT_PUBLIC_AGENT_API_KEY" > .env.production

RUN npm run build

# Runner
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000
CMD ["node", "server.js"]
