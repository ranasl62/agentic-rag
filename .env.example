# Agentic RAG — env example (Phases 1–6: auth, rate limit, cache, async ingest, Nginx, PgBouncer, metrics)
# Copy to .env and set POSTGRES_PASSWORD and other values as needed.

# PostgreSQL
# From host (scripts, psql): use localhost and 5433 (Docker published port). API/Celery in Docker use PgBouncer (Phase 5).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Host port published by Docker for postgres (5433 avoids clash with local Postgres on 5432)
POSTGRES_PUBLISH_PORT=5433
POSTGRES_DB=agentic_rag
POSTGRES_USER=agentic_rag
POSTGRES_PASSWORD=change_me_secure_password

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Ollama (API service talks to Ollama from inside Docker)
# Use host's Ollama (default): leave unset or set to http://host.docker.internal
#   - Start Ollama on the host (e.g. ollama serve) so upload/query can use embeddings and chat.
# Use Ollama in Docker: set OLLAMA_HOST=http://ollama and run: docker compose --profile with-ollama up -d
OLLAMA_HOST=http://host.docker.internal
OLLAMA_PORT=11434
# Pull in Ollama: ollama pull nomic-embed-text && ollama pull llama3.2 (and any per-task models below)
OLLAMA_EMBED_MODEL=nomic-embed-text
# Default for all chat tasks; override per task to use different models
OLLAMA_CHAT_MODEL=llama3.2
# Optional: use a different model per task (leave unset to use OLLAMA_CHAT_MODEL)
# OLLAMA_SEARCH_ANSWER_MODEL=llama3.2
# OLLAMA_QUERY_MODEL=llama3.2
# OLLAMA_SUMMARIZE_MODEL=llama3.2
# OLLAMA_COMPARE_MODEL=llama3.2
# OLLAMA_VERIFY_MODEL=llama3.2

# Optional: use OpenAI or Anthropic (Claude/Opus) instead of Ollama for chat
# CHAT_PROVIDER=ollama | openai | anthropic (default ollama)
# CHAT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# CHAT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# Optional: use OpenAI for embeddings (re-ingest required; dimension 1536)
# EMBED_PROVIDER=ollama | openai (default ollama)
# EMBED_PROVIDER=openai
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Auth (Phase 1: API key per tenant)
# REQUIRE_AUTH=true: protected endpoints require X-API-Key. false: use DEFAULT_TENANT_SLUG when key missing (dev).
REQUIRE_AUTH=true
DEFAULT_TENANT_SLUG=default

# Phase 2: Rate limiting (per tenant per minute; 0 = no limit)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SEARCH_PER_MIN=100
RATE_LIMIT_QUERY_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=5
RATE_LIMIT_COMPARE_PER_MIN=30
RATE_LIMIT_SUMMARIZE_PER_MIN=30
RATE_LIMIT_LIST_PER_MIN=60
RATE_LIMIT_IP_PER_MIN=0

# Phase 2: Caching (TTL seconds; 0 = disabled)
CACHE_ENABLED=true
CACHE_SEARCH_TTL_SECONDS=300
CACHE_QUERY_TTL_SECONDS=120

# Phase 3: Async ingestion (Celery)
# CELERY_BROKER_URL=redis://localhost:6379/0  (defaults to redis_url)
INGEST_JOB_STATUS_TTL_SECONDS=86400
INGEST_ASYNC_DEFAULT=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# App
LOG_LEVEL=INFO
# Phase 6: Prometheus metrics at GET /metrics. Set false to disable (returns 404).
METRICS_ENABLED=true
API_HOST=0.0.0.0
# Phase 4: Nginx LB publishes API here (default 8080). Set to 8000 if running API without Nginx.
API_PORT=8080

# Next.js web (Docker); 3001 to avoid clash with other apps on 3000
WEB_PORT=3001
# URL the browser uses for the RAG API (host-visible; must match API_PORT, e.g. http://localhost:8080 with Phase 4)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Ingestion
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
